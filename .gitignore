# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials/

# Test / coverage artefacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
coverage.xml

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local scratch
*.log
*.tmp
_out.txt
_report.txt

# Generated artefacts — regenerable, so never committed.
#   python scripts/handoff_pdf.py   -> ActionMesh-Handoff.pdf
#   python scripts/snapshot.py      -> actionmesh-snapshot-<stamp>.zip (beside the tree)
ActionMesh-Handoff.pdf
*actionmesh-snapshot*

# Android build toolchain and outputs — large, downloaded, regenerable.
#   python scripts/build_apk.py     -> dist/actionmesh-<version>.apk
android-toolchain/
*.keystore
*.jks

# Desktop shell dependencies and staged backend runtime — downloaded, regenerable.
#   npm --prefix desktop ci
#   python scripts/bundle_runtime.py
desktop/node_modules/
desktop/runtime/
desktop/release/
desktop/.stage/

# Scratch working files from driving the API by hand. The outcomes worth keeping are
# the tests under tests/; these are transcripts and local databases from a demo run.
.demo/
pytest-run.txt


# Browser / editor safety — never commit machine-local state
.claude/
.serena/
*.local
