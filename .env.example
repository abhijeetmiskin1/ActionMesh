# ActionMesh configuration.
#
# Copy to `.env` and fill in. NEVER commit `.env` — it is git-ignored.
# Every value here is OPTIONAL: the platform runs fully offline with MOCK
# providers and needs none of them.

# --- Core ---------------------------------------------------------------
# SQLite location for deployments that inject the durable C15 stores.
ACTIONMESH_DATABASE_URL=sqlite:///./actionmesh.db
# Local bind address for the FastAPI service.
ACTIONMESH_HOST=127.0.0.1
ACTIONMESH_PORT=8080

# Optional transport guard. Use a secret manager in production.
ACTIONMESH_API_KEY=
# Maximum accepted HTTP request body size in bytes.
ACTIONMESH_MAX_REQUEST_BYTES=1048576

# --- LLM provider (C13) --------------------------------------------------
# The planner defaults to the deterministic, offline RuleBasedPlanner; no vendor
# LLM adapter is wired up. Replace it by injecting a `Planner` (see
# actionmesh/core/planner.py) — its output is untrusted either way.
# One of: mock | openai | anthropic | gemini | local
ACTIONMESH_LLM_PROVIDER=mock
ACTIONMESH_LLM_API_KEY=
ACTIONMESH_LLM_MODEL=

# --- Secrets -------------------------------------------------------------
# Signing key for request signing and device authentication (C11/C13).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACTIONMESH_SECRET_KEY=

# --- Security defaults ---------------------------------------------------
# Requires explicit user approval for HIGH-risk actions. Leave false unless
# you understand the trade-off: true lets policy auto-allow HIGH risk.
ACTIONMESH_ALLOW_HIGH_RISK=false
