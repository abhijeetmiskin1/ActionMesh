# ActionMesh configuration.
#
# Copy to `.env` and fill in. NEVER commit `.env` — it is git-ignored.
# Every value here is OPTIONAL: the platform runs fully offline with MOCK
# providers and needs none of them.

# --- Core ---------------------------------------------------------------
# Deployment mode: development (default) | lan | production. Production refuses to
# start unless durable storage, a durable audit chain, a durable signing key and a
# shared API key are all present. See docs/deployment.md.
ACTIONMESH_ENV=development
# SQLite location for deployments that inject the durable C15 stores.
ACTIONMESH_DATABASE_URL=sqlite:///./actionmesh.db
# Local bind address for the FastAPI service.
ACTIONMESH_HOST=127.0.0.1
ACTIONMESH_PORT=8080
# Externally visible base URL (required in production).
ACTIONMESH_PUBLIC_BASE_URL=
# Comma-separated proxy addresses whose Forwarded headers may be trusted. Required in
# production when binding to a non-loopback address.
ACTIONMESH_TRUSTED_PROXIES=

# Optional transport guard. Use a secret manager in production.
ACTIONMESH_API_KEY=
# Maximum accepted HTTP request body size in bytes.
ACTIONMESH_MAX_REQUEST_BYTES=1048576
# Process-local rate limiting on pairing/execute/approval/stream endpoints. Set to 0
# only to hammer your own local dev server; a deployment enforces the same policy at
# the proxy.
ACTIONMESH_RATE_LIMIT=1

# --- LLM provider (C13) --------------------------------------------------
# The planner defaults to the deterministic, offline RuleBasedPlanner; no vendor
# LLM adapter is wired up. Replace it by injecting a `Planner` (see
# actionmesh/core/planner.py) — its output is untrusted either way.
# One of: mock | openai | anthropic | gemini | local
ACTIONMESH_LLM_PROVIDER=mock
ACTIONMESH_LLM_API_KEY=
ACTIONMESH_LLM_MODEL=

# --- Secrets -------------------------------------------------------------
# Key material that hashes pairing codes and device credentials (C19).
# Resolution order matters:
#   set this           -> durable, nothing written to disk
#   or set the file    -> durable, a 0600 file created on first use
#   or leave both blank-> a random key that dies with the process, so every
#                         restart unpairs every device
# The last one is the safe default for a laptop you own, and the wrong answer for
# anything you expect to survive a reboot. A file that is group- or world-readable
# is REFUSED rather than used.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACTIONMESH_SECRET_KEY=
ACTIONMESH_SECRET_FILE=

# --- Laptop agent (C19) ---------------------------------------------------
# The agent is the only part of ActionMesh that touches this machine. Everything
# here defaults to closed: no root means no file capabilities, no shell flag means no
# terminal, process, server, application or editor capability is even registered.
ACTIONMESH_AGENT=0
ACTIONMESH_DEVICE_ID=laptop-1
ACTIONMESH_DEVICE_NAME=
# Absolute, must exist. A relative root resolves against wherever the server started,
# which is a different boundary every time -- so it is refused, not guessed.
ACTIONMESH_WORKSPACE_ROOT=
# Programs this laptop will run, resolved through PATH and compared as real paths.
# Empty means the built-in development set, never "anything".
ACTIONMESH_ALLOWED_COMMANDS=
# Extra names to refuse even if they appear in the allowlist.
ACTIONMESH_DENIED_COMMANDS=
# `python -c '<source>'` is a program the caller writes. Off: an allowlisted
# interpreter may run installed modules (-m) and files, not inline source.
ACTIONMESH_ALLOW_INTERPRETER_CODE=false
# Additional absolute directories a command may start in, comma-separated.
ACTIONMESH_ALLOWED_WORKDIRS=
# Names a child process may inherit from this laptop's own environment. Anything
# secret-shaped is refused even if listed, and os.environ is never passed wholesale.
ACTIONMESH_EXTRA_ENV=
ACTIONMESH_MAX_CONCURRENT_PROCESSES=4
# Where a launched (detached) child keeps its stdout and stderr. Unset, a child's output
# is discarded exactly as it always was. Set, each child gets a 0600 file here, and
# device.process.logs can read it back -- a file rather than a pipe because a pipe nobody
# drains stops the server that writes to it. Must be absolute and outside the workspace:
# under the root, any phone with file.read could collect whatever that server printed.
# Bounded by trimming from the front once a log passes 512 KiB.
ACTIONMESH_AGENT_LOG_DIR=
# The timeout a command actually gets. A caller's `timeout_s` can only lower this,
# never raise it; a run cut short by it reports `timeout_clipped: true` rather than
# stopping silently. Long-lived work is a server, not a held-open terminal call.
ACTIONMESH_COMMAND_TIMEOUT_S=60
ACTIONMESH_HEARTBEAT_S=15

# --- Devices and pairing (C19) -------------------------------------------
# Minting a pairing code is restricted to loopback, because a code is what a human
# reads off the laptop's screen. Set true only when the laptop is reachable solely
# through a relay you control — this is the door that "do not port-forward" closes.
ACTIONMESH_ALLOW_REMOTE_PAIRING=false

# --- Security defaults ---------------------------------------------------
# Requires explicit user approval for HIGH-risk actions. Leave false unless
# you understand the trade-off: true lets policy auto-allow HIGH risk.
ACTIONMESH_ALLOW_HIGH_RISK=false
