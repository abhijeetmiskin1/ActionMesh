# Line endings: source text is LF everywhere. Windows executables stay CRLF.
* text=auto eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.sh   text eol=lf
*.bat  text eol=crlf
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.apk  binary
*.exe  binary
